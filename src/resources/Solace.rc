#include <windows.h>

#define IDI_SOLACE 101
#define IDR_NVIDIA_PROFILE_INSPECTOR_EXE 201
#define IDR_NVIDIA_PROFILE_INSPECTOR_XML 202
#define IDR_NVIDIA_PROFILE_INSPECTOR_NIP 203

IDI_SOLACE ICON "solace.ico"

// NVIDIA Profile Inspector by Orbmu2k (open source), bundled so the app is
// a single self-contained exe. Extracted to a temp folder and launched on
// demand — see backend::launch_nvidia_profile_inspector().
IDR_NVIDIA_PROFILE_INSPECTOR_EXE RCDATA "embedded/nvidiaProfileInspector.exe"
IDR_NVIDIA_PROFILE_INSPECTOR_XML RCDATA "embedded/Reference.xml"
// SapphireOS's own curated driver-setting profile — extracted alongside
// the tool so the user can import it (File > Import) if they want it.
IDR_NVIDIA_PROFILE_INSPECTOR_NIP RCDATA "embedded/Settings.nip"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "SZK\0"
            VALUE "FileDescription", "SZK Interface\0"
            VALUE "FileVersion", "0.1.0.0\0"
            VALUE "InternalName", "SZK\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 SZK\0"
            VALUE "OriginalFilename", "Solace.exe\0"
            VALUE "ProductName", "SZK\0"
            VALUE "ProductVersion", "0.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
