#include <windows.h>

#include "resource.h"

// One resource script for both products. The build sets PRODUCT_BRAND for the
// resource compiler as well as for the compiler, so the icon and the version
// block follow whichever exe is being produced.
#ifndef PRODUCT_BRAND
#define PRODUCT_BRAND 0
#endif

#if PRODUCT_BRAND == 1
IDI_APP ICON "less.ico"
#else
IDI_APP ICON "numbanine.ico"
#endif

// NVIDIA Profile Inspector by Orbmu2k (open source), bundled so the app is
// a single self-contained exe. Extracted to a temp folder and launched on
// demand — see backend::launch_nvidia_profile_inspector().
IDR_NVIDIA_PROFILE_INSPECTOR_EXE RCDATA "embedded/nvidiaProfileInspector.exe"
IDR_NVIDIA_PROFILE_INSPECTOR_XML RCDATA "embedded/Reference.xml"
// SapphireOS's own curated driver-setting profile — extracted alongside
// the tool so the user can import it (File > Import) if they want it.
IDR_NVIDIA_PROFILE_INSPECTOR_NIP RCDATA "embedded/Settings.nip"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
#if PRODUCT_BRAND == 1
            VALUE "CompanyName", "Less\0"
            VALUE "FileDescription", "Less Interface\0"
            VALUE "FileVersion", "0.1.0.0\0"
            VALUE "InternalName", "Less\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 Less\0"
            VALUE "OriginalFilename", "Less.exe\0"
            VALUE "ProductName", "Less\0"
#else
            VALUE "CompanyName", "numbanine\0"
            VALUE "FileDescription", "numbanine Interface\0"
            VALUE "FileVersion", "0.1.0.0\0"
            VALUE "InternalName", "numbanine\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 numbanine\0"
            VALUE "OriginalFilename", "numbanine.exe\0"
            VALUE "ProductName", "numbanine\0"
#endif
            VALUE "ProductVersion", "0.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
